# ---------------------------------------------------------------------------
# Copy this to .env and fill in real values. This file IS committed to git;
# .env is NOT (see .gitignore) — never put real secrets in this file.
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-generate-with-get_random_secret_key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL --------------------------------------------------------
# Adjust POSTGRES_HOST_PORT if 5432 is already taken on your machine.
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5435

# --- Valkey (Redis-protocol cache + Celery broker) ----------------------
VALKEY_HOST_PORT=6379
CELERY_BROKER_URL=redis://cache:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- JWT -----------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MIN=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Django app port on the host -----------------------------------------
DJANGO_HOST_PORT=8000

# --- Production-only (see config/settings/production.py) -----------------
# DJANGO_ENABLE_SSL_REDIRECT=True
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
